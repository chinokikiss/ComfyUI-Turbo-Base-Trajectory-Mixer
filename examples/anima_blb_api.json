{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "anima_baseV10.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "TurboBaseTrajectoryMixer",
    "inputs": {
      "model": ["1", 0], "turbo_lora": "anima-turbo-lora-v0.2.safetensors",
      "lora_strength": 1.0, "turbo_cfg": 1.0,
      "scheme": "Base composition / Base style",
      "scheme.prefix_ratio": 0.5, "scheme.suffix_ratio": 0.5
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "anima_baseV10_txt.safetensors", "type": "stable_diffusion", "device": "cpu"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {"clip": ["3", 0], "text": "1girl, blonde hair, blue eyes, white dress, plain blue background, anime illustration"}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {"clip": ["3", 0], "text": "worst quality, low quality, blurry, jpeg artifacts"}
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": 512, "height": 512, "batch_size": 1}
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {"model": ["2", 0], "seed": 0, "steps": 12, "cfg": 4.0, "sampler_name": "euler",
               "scheduler": "simple", "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0], "denoise": 1.0}
  },
  "8": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "qwen_image_vae.safetensors"}
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["7", 0], "vae": ["8", 0]}
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {"images": ["9", 0], "filename_prefix": "TurboBaseMixer/BLB"}
  }
}
